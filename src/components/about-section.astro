---
import { Icon } from 'astro-icon/components';
import MediaFrame from './media-frame.astro';
import SectionHeading from './section-heading.astro';
import { MEDIA } from '../lib/config';

const paragraphs = [
  'We all are dedicated TCG Players ourselves and want to share this amazing hobby with as many as possible!',
  'We embrace new members to make the community grow bigger and teach anyone how to play any game!',
  'So come and dive into an awesome world of strategy, fun and competition!',
];

const pillars = [
  {
    icon: 'tabler:users-group',
    title: 'Community',
    text: 'New faces are always welcome — you will find people to play with right away.',
  },
  {
    icon: 'tabler:school',
    title: 'We teach you',
    text: 'Whichever game you pick: we explain the rules and play the first rounds with you.',
  },
  {
    icon: 'tabler:trophy',
    title: 'Competition',
    text: 'From a relaxed casual evening to a competitive tournament — you choose how hard you play.',
  },
];
---

<section id="about" class="relative scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-14 lg:grid-cols-2 lg:items-center lg:gap-16">
      <!-- Images -->
      <div data-reveal="left" class="relative order-2 lg:order-1">
        <MediaFrame
          src={MEDIA.storefront.src}
          fallback={MEDIA.storefront.fallback}
          alt="The Mana Games storefront on Blissestrasse in Berlin at dusk"
          label="Blissestr. 5 · Berlin-Wilmersdorf"
          ratio="aspect-[4/3]"
          loading="eager"
          tilt={6}
        />

        <div class="mt-5 grid grid-cols-[1.35fr_1fr] gap-5">
          <MediaFrame
            src={MEDIA.community.src}
            fallback={MEDIA.community.fallback}
            alt="A packed tournament room at Mana Games with players at the tables"
            label="Tournament night at the store"
            ratio="aspect-[4/3]"
            tilt={7}
          />

          <!-- Quote card -->
          <div class="panel panel-hover corners flex flex-col justify-between p-5">
            <Icon name="tabler:quote" size={22} class="text-mana-400/70" />
            <p class="font-display text-sm font-semibold leading-snug text-neutral-200">
              &ldquo;Trading Card Game is not a hobby, but a lifestyle.&rdquo;
            </p>
            <span class="eyebrow text-[9px] text-mana-300/70">Team Mana Games</span>
          </div>
        </div>
      </div>

      <!-- Text -->
      <div data-reveal="right" class="order-1 lg:order-2">
        <SectionHeading eyebrow="01 — About us" title="We are players" accent="just like you." />

        <div class="mt-8 space-y-5">
          {
            paragraphs.map((text, index) => (
              <p
                data-reveal
                style={`--reveal-delay:${index * 90}ms`}
                class="text-lg leading-relaxed text-neutral-300"
              >
                {text}
              </p>
            ))
          }

          <p data-reveal style="--reveal-delay:280ms" class="pt-2">
            <span
              class="inline-flex items-center gap-2 font-display text-xl font-bold text-gradient"
            >
              We hope to meet you soon!
              <Icon name="tabler:arrow-right" size={20} class="text-mana-400" />
            </span>
          </p>
        </div>

        <ul class="mt-10 grid gap-3 sm:grid-cols-3">
          {
            pillars.map((pillar, index) => (
              <li
                data-reveal
                style={`--reveal-delay:${index * 100}ms`}
                data-tilt="6"
                class="panel panel-hover holo group flex flex-col gap-3 p-5"
              >
                <span class="grid h-10 w-10 place-items-center rounded-xl border border-mana-400/25 bg-mana-400/10 text-mana-300 transition-colors duration-300 group-hover:border-mana-400/60 group-hover:text-mana-200">
                  <Icon name={pillar.icon} size={20} />
                </span>
                <span class="font-display text-sm font-bold text-neutral-100">{pillar.title}</span>
                <span class="text-xs leading-relaxed text-neutral-400">{pillar.text}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
