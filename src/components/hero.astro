---
import { Icon } from 'astro-icon/components';
import { GAMES, SITE, STATS } from '../lib/config';

// Cards in the fan — ordered back to front
const fanCards = [
  GAMES.find((g) => g.key === 'Riftbound')!,
  GAMES.find((g) => g.key === 'One Piece')!,
  GAMES.find((g) => g.key === 'Pokemon')!,
  GAMES.find((g) => g.key === 'Yu-Gi-Oh!')!,
  GAMES.find((g) => g.key === 'Magic')!,
];

const ticker = [...GAMES.map((g) => g.name), 'Singles', 'Sealed', 'Accessoires'];
---

<section class="relative overflow-hidden pb-20 pt-10 sm:pt-16 lg:pb-28 lg:pt-20">
  <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-[1.05fr_.95fr] lg:gap-8">
    <!-- Text -->
    <div class="relative z-10">
      <div
        data-reveal
        class="inline-flex items-center gap-2.5 rounded-full border border-mana-400/25 bg-black/50 px-3.5 py-1.5 backdrop-blur"
      >
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-mana-400 animate-pulse-ring"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-mana-300"></span>
        </span>
        <span class="eyebrow text-[10px] font-semibold text-mana-200">
          {SITE.street} · {SITE.city}
        </span>
      </div>

      <h1
        data-reveal
        style="--reveal-delay:80ms"
        class="mt-6 font-display text-[clamp(2.75rem,9vw,6.5rem)] font-bold uppercase leading-[0.92] tracking-tight"
      >
        <span class="block text-neutral-50">Mana</span>
        <span class="block text-gradient">Games</span>
      </h1>

      <p
        data-reveal
        style="--reveal-delay:160ms"
        class="mt-6 max-w-xl font-display text-xl font-medium text-neutral-200 sm:text-2xl"
      >
        {SITE.tagline}
      </p>

      <p data-reveal style="--reveal-delay:220ms" class="mt-4 max-w-xl text-base leading-relaxed text-neutral-400">
        Your local game store in Berlin-Wilmersdorf. Singles, sealed products and accessoires
        for 9 trading card games — plus tournaments six evenings a week.
      </p>

      <div data-reveal style="--reveal-delay:300ms" class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#schedule" class="btn btn-primary">
          <Icon name="tabler:calendar-event" size={18} />
          See the schedule
        </a>
        <a href={SITE.mapsUrl} target="_blank" rel="noopener" class="btn btn-ghost">
          <Icon name="tabler:map-pin" size={18} />
          Get directions
        </a>
      </div>

      <!-- Stats -->
      <dl data-reveal style="--reveal-delay:380ms" class="mt-12 grid max-w-lg grid-cols-3 gap-4">
        {
          STATS.map((stat) => (
            <div class="panel panel-hover px-4 py-4">
              <dt class="sr-only">{stat.label}</dt>
              <dd>
                <span class="block font-display text-3xl font-bold text-gradient sm:text-4xl">
                  <span data-count={stat.value}>0</span>
                  {stat.suffix}
                </span>
                <span class="mt-1.5 block text-[11px] leading-tight text-neutral-400">{stat.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Card fan -->
    <div class="relative">
      <div
        id="card-fan"
        class="relative mx-auto flex h-[clamp(320px,52vw,520px)] w-full max-w-lg items-center justify-center"
        style="perspective:1400px"
        aria-hidden="true"
      >
        <!-- Glow behind the fan -->
        <div
          class="absolute h-[70%] w-[70%] rounded-full bg-mana-500/25 blur-[90px]"
        >
        </div>
        <div
          class="absolute h-[46%] w-[46%] rounded-full border border-mana-400/20"
          style="animation:pulseRing 3.4s ease-out infinite"
        >
        </div>

        {
          fanCards.map((game, index) => {
            const total = fanCards.length;
            const mid = (total - 1) / 2;
            const offset = index - mid;
            return (
              <article
                class="fan-card holo"
                data-depth={(index + 1) / total}
                style={`--rot:${offset * 13}deg; --tx:${offset * 52}px; --ty:${Math.abs(offset) * 16}px; --z:${index}; --accent:${game.color};`}
              >
                <div class="fan-inner">
                  <span class="fan-top">
                    <span class="fan-dot" />
                    <span class="fan-cost">{String(index + 1)}</span>
                  </span>
                  <span class="fan-art">
                    <svg viewBox="0 0 100 100" class="h-14 w-14 opacity-90">
                      <path
                        d="M50 8 L88 30 V70 L50 92 L12 70 V30 Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                      />
                      <circle cx="50" cy="50" r="14" fill="none" stroke="currentColor" stroke-width="3" />
                    </svg>
                  </span>
                  <span class="fan-name">{game.key}</span>
                  <span class="fan-rule" />
                  <span class="fan-foot">Mana Games · Berlin</span>
                </div>
              </article>
            );
          })
        }
      </div>

      <p class="mt-3 text-center text-[11px] text-neutral-600 lg:mt-0">
        <span class="hidden lg:inline">Move your mouse over the cards</span>
        <span id="tap-hint" class="inline-flex items-center gap-2 lg:hidden">
          <span class="relative flex h-1.5 w-1.5 shrink-0">
            <span class="absolute inline-flex h-full w-full rounded-full bg-mana-400/60 animate-pulse-ring"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-mana-400/80"></span>
          </span>
          <span class="eyebrow text-[9px] text-mana-300/60 tracking-[0.22em]">Tap a card to play it</span>
          <span class="relative flex h-1.5 w-1.5 shrink-0">
            <span class="absolute inline-flex h-full w-full rounded-full bg-mana-400/60 animate-pulse-ring" style="animation-delay:0.6s"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-mana-400/80"></span>
          </span>
        </span>
      </p>
    </div>
  </div>

  <!-- Ticker -->
  <div class="marquee-mask relative mt-16 border-y border-mana-400/10 bg-black/40 py-4 backdrop-blur-sm">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {ticker.map((item) => (
              <span class="flex items-center gap-6 px-6">
                <span class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-neutral-400 transition-colors hover:text-mana-300">
                  {item}
                </span>
                <span class="h-1 w-1 rotate-45 bg-mana-400/70" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .fan-card {
    position: absolute;
    width: clamp(140px, 22vw, 200px);
    aspect-ratio: 5 / 7;
    border-radius: 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    background:
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 16%, transparent), rgba(5, 8, 6, 0.94) 55%),
      #06090b;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 30px 60px -25px rgba(0, 0, 0, 0.95),
      0 0 45px -18px var(--accent);
    z-index: calc(var(--z) + 1);
    transform: translate3d(var(--tx), var(--ty), 0) rotate(var(--rot));
    transition:
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.5s ease;
    will-change: transform;
  }

  /* Fly-in animation on load */
  #card-fan.is-ready .fan-card {
    animation: fanIn 1s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--z) * 90ms + 150ms);
  }

  @keyframes fanIn {
    from {
      opacity: 0;
      transform: translate3d(0, 70px, 0) rotate(0deg) scale(0.9);
    }
    to {
      opacity: 1;
      transform: translate3d(var(--tx), var(--ty), 0) rotate(var(--rot));
    }
  }

  .fan-card:hover,
  .fan-card.is-tapped {
    z-index: 20;
    box-shadow:
      0 0 0 1px var(--accent),
      0 40px 80px -30px rgba(0, 0, 0, 1),
      0 0 90px -20px var(--accent);
  }

  .fan-card.is-tapped {
    transform: translate3d(var(--tx), calc(var(--ty) - 22px), 0) rotate(calc(var(--rot) * 0.4)) scale(1.08) !important;
  }

  .fan-inner {
    position: absolute;
    inset: 7px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9px;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    padding: 0.7rem 0.6rem;
    color: var(--accent);
  }

  .fan-top {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
  }

  .fan-dot {
    height: 6px;
    width: 6px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
  }

  .fan-cost {
    display: grid;
    height: 18px;
    width: 18px;
    place-items: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
    font-size: 10px;
    font-weight: 700;
  }

  .fan-art {
    display: grid;
    flex: 1;
    width: 100%;
    place-items: center;
    border-radius: 6px;
    background: radial-gradient(ellipse at center, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%);
  }

  .fan-name {
    font-size: clamp(0.6rem, 1.5vw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f5f5f5;
    text-align: center;
    line-height: 1.15;
  }

  .fan-rule {
    height: 1px;
    width: 70%;
    background: linear-gradient(to right, transparent, var(--accent), transparent);
  }

  .fan-foot {
    font-size: 7px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    #card-fan.is-ready .fan-card {
      animation: none;
    }
  }
</style>

<script>
  const fan = document.getElementById('card-fan');
  if (fan) {
    fan.classList.add('is-ready');

    const cards = Array.from(fan.querySelectorAll<HTMLElement>('.fan-card'));
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (fine && !reduce) {
      /* Desktop: mouse parallax */
      let frame = 0;
      const container = fan.closest('section') as HTMLElement;

      container?.addEventListener('pointermove', (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const rect = fan.getBoundingClientRect();
          const dx = (event.clientX - (rect.left + rect.width / 2)) / rect.width;
          const dy = (event.clientY - (rect.top + rect.height / 2)) / rect.height;

          cards.forEach((card) => {
            const depth = Number(card.dataset.depth) || 0.5;
            const shiftX = dx * 46 * depth;
            const shiftY = dy * 30 * depth;
            card.style.transform = `translate3d(calc(var(--tx) + ${shiftX}px), calc(var(--ty) + ${shiftY}px), 0) rotate(calc(var(--rot) + ${dx * 5 * depth}deg))`;
            card.style.setProperty('--mx', `${50 + dx * 90}%`);
            card.style.setProperty('--my', `${50 + dy * 90}%`);
            card.classList.add('is-active');
          });
        });
      });

      container?.addEventListener('pointerleave', () => {
        cards.forEach((card) => {
          card.style.transform = '';
          card.classList.remove('is-active');
        });
      });
    } else if (!reduce) {
      /* Mobile: tap a card to bring it to the front */
      let tapped: HTMLElement | null = null;

      cards.forEach((card) => {
        card.addEventListener('pointerdown', (event) => {
          event.stopPropagation();

          if (tapped === card) {
            /* tap same card again → collapse */
            card.classList.remove('is-tapped', 'is-active');
            tapped = null;
            return;
          }

          /* untap previous */
          if (tapped) {
            tapped.classList.remove('is-tapped', 'is-active');
            tapped.style.zIndex = '';
          }

          card.classList.add('is-tapped', 'is-active');
          tapped = card;
        });
      });

      /* tap outside → collapse */
      fan.addEventListener('pointerdown', () => {
        if (tapped) {
          tapped.classList.remove('is-tapped', 'is-active');
          tapped = null;
        }
      });
    }
  }
</script>
