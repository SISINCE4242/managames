---
import type { GamePattern } from '../lib/config';

interface Props {
  pattern: GamePattern;
}

const { pattern } = Astro.props;
---

<!--
  Purely generic, self-drawn SVG geometry per game — no artwork, logos or
  franchise symbols. Colored via currentColor so it inherits --accent.
-->
<span class="game-pattern" aria-hidden="true">
  {
    pattern === 'magic' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <circle cx="172" cy="150" r="42" stroke-width="0.6" opacity="0.55" />
        <circle cx="172" cy="150" r="64" stroke-width="0.5" opacity="0.35" />
        <circle cx="172" cy="150" r="86" stroke-width="0.4" opacity="0.2" />
        <g fill="currentColor" stroke="none" opacity="0.7">
          <circle cx="138" cy="108" r="1.6" />
          <circle cx="158" cy="186" r="1.2" />
          <circle cx="192" cy="118" r="1.4" />
          <circle cx="118" cy="158" r="1" />
          <circle cx="186" cy="68" r="1.2" />
        </g>
      </svg>
    )
  }
  {
    pattern === 'yugioh' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <path d="M96 200 L200 96" stroke-width="0.55" opacity="0.55" />
        <path d="M118 200 L200 118" stroke-width="0.55" opacity="0.45" />
        <path d="M140 200 L200 140" stroke-width="0.5" opacity="0.35" />
        <path d="M162 200 L200 162" stroke-width="0.45" opacity="0.28" />
        <circle cx="185" cy="150" r="34" stroke-width="0.45" opacity="0.32" />
      </svg>
    )
  }
  {
    pattern === 'pokemon' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <path d="M85 195 Q120 165 155 195 T225 195" stroke-width="0.6" opacity="0.5" />
        <path d="M78 170 Q113 140 148 170 T218 170" stroke-width="0.55" opacity="0.38" />
        <path d="M72 145 Q107 115 142 145 T212 145" stroke-width="0.5" opacity="0.26" />
        <g fill="currentColor" stroke="none" opacity="0.65">
          <circle cx="178" cy="100" r="1.4" />
          <circle cx="152" cy="80" r="1" />
          <circle cx="196" cy="128" r="1.2" />
        </g>
      </svg>
    )
  }
  {
    pattern === 'onepiece' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <path d="M80 200 Q120 178 160 200 T240 200" stroke-width="0.6" opacity="0.5" />
        <path d="M72 176 Q112 154 152 176 T232 176" stroke-width="0.55" opacity="0.38" />
        <path d="M64 152 Q104 130 144 152 T224 152" stroke-width="0.5" opacity="0.26" />
        <path d="M126 62 L200 32" stroke-width="0.5" opacity="0.4" />
        <path d="M138 84 L200 58" stroke-width="0.4" opacity="0.28" />
      </svg>
    )
  }
  {
    pattern === 'naruto' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <path d="M54 200 L200 96" stroke-width="0.6" opacity="0.5" />
        <path d="M70 200 L200 118" stroke-width="0.55" opacity="0.4" />
        <path d="M86 200 L200 140" stroke-width="0.5" opacity="0.32" />
        <path d="M102 200 L200 162" stroke-width="0.45" opacity="0.24" />
        <path
          d="M172 142 C 194 142 200 164 181 173 C 163 181 154 162 168 153"
          stroke-width="0.5"
          opacity="0.4"
        />
      </svg>
    )
  }
  {
    pattern === 'dragonball' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <circle cx="178" cy="158" r="16" stroke-width="0.6" opacity="0.5" />
        <circle cx="178" cy="158" r="32" stroke-width="0.5" opacity="0.36" />
        <circle cx="178" cy="158" r="48" stroke-width="0.4" opacity="0.24" />
        <g stroke-width="0.5" opacity="0.35">
          <path d="M178 158 L178 98" />
          <path d="M178 158 L222 116" />
          <path d="M178 158 L234 158" />
          <path d="M178 158 L222 200" />
          <path d="M178 158 L138 116" />
        </g>
      </svg>
    )
  }
  {
    pattern === 'riftbound' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <path d="M146 200 L172 138 L208 154 L198 200 Z" stroke-width="0.5" opacity="0.42" />
        <path d="M172 138 L188 86 L220 108 L208 154 Z" stroke-width="0.4" opacity="0.32" />
        <path d="M112 200 L146 200 L172 138 L134 150 Z" stroke-width="0.4" opacity="0.24" />
        <g stroke-width="0.3" opacity="0.24">
          <path d="M96 200 L200 200 M96 178 L200 156 M96 156 L200 114" />
        </g>
      </svg>
    )
  }
  {
    pattern === 'fleshblood' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <g fill="currentColor" stroke="none" opacity="0.6">
          <circle cx="176" cy="98" r="1.6" />
          <circle cx="192" cy="140" r="1.1" />
          <circle cx="160" cy="170" r="1.3" />
          <circle cx="200" cy="180" r="0.9" />
        </g>
        <g stroke-width="0.4" opacity="0.3">
          <path d="M116 200 L200 148" />
          <path d="M128 190 L200 164" />
          <path d="M140 180 L200 178" />
        </g>
      </svg>
    )
  }
  {
    pattern === 'digimon' && (
      <svg viewBox="0 0 200 200" preserveAspectRatio="xMaxYMax slice" fill="none" stroke="currentColor">
        <g stroke-width="0.35" opacity="0.36">
          <path d="M120 200 V120 M145 200 V120 M170 200 V120 M195 200 V120" />
          <path d="M120 120 H200 M120 145 H200 M120 170 H200 M120 195 H200" />
        </g>
        <g fill="currentColor" stroke="none" opacity="0.5">
          <rect x="150" y="135" width="4" height="4" />
          <rect x="175" y="160" width="3" height="3" />
          <rect x="130" y="155" width="3" height="3" />
        </g>
      </svg>
    )
  }
</span>

<style>
  .game-pattern {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--accent);
    opacity: 0.12;
    pointer-events: none;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .game-pattern svg {
    display: block;
    height: 100%;
    width: 100%;
  }

  .game-tile:hover .game-pattern {
    opacity: 0.24;
    transform: scale(1.05);
  }
</style>
