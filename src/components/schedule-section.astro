---
import { Icon } from 'astro-icon/components';
import SectionHeading from './section-heading.astro';
import { GAME_COLORS, MEDIA, SCHEDULE } from '../lib/config';
import { DAY_NAMES, UI } from '../lib/i18n';

const totalEvents = SCHEDULE.reduce((sum, day) => sum + day.slots.length, 0);
---

<section id="schedule" class="relative scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto mb-20 h-px max-w-7xl bg-gradient-to-r from-transparent via-mana-400/35 to-transparent"></div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="flex min-w-0 items-end justify-between gap-4 lg:contents">
        <SectionHeading
          eyebrow="03 — Tournament Schedule"
          eyebrowKey="schedule.eyebrow"
          title="Six evenings."
          titleKey="schedule.title"
          accent={`${totalEvents} tournaments.`}
          accentDe={`${totalEvents} ${UI.de['schedule.tournaments']}.`}
        />
        <!-- Mobile/tablet only: desktop keeps its own floating mascot below, untouched -->
        <div data-reveal="right" class="mascot-point-mobile shrink-0 lg:hidden">
          <div class="mascot-bubble-wrap">
            <span class="mascot-bubble" style="bottom:auto;top:0.25rem" data-i18n="bubble.schedule">Pick a night and join us! 🎴</span>
            <img src={MEDIA.mascotPoint.src} alt="Our Mana Games mascot pointing at the schedule" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
      <div data-reveal style="--reveal-delay:120ms" class="flex flex-col gap-3">
        <p class="max-w-sm text-lg leading-relaxed text-neutral-400" data-i18n-html="schedule.introText">
          Locked into the calendar every week.<br>Pick your day — we take care of the rest.
        </p>
        <p class="flex items-center gap-2 text-sm font-semibold text-mana-300">
          <Icon name="tabler:alert-circle" size={17} />
          <span data-i18n="schedule.regOnly">On-site registration only!</span>{' '}
          <span class="font-normal text-neutral-500" data-i18n="schedule.regOnlyDe">(Anmeldung nur vor Ort)</span>
        </p>
      </div>
    </div>

    <!-- Next tournament -->
    <div
      id="next-event"
      data-reveal
      class="mt-12 hidden items-center gap-4 rounded-2xl border border-mana-400/30 bg-mana-400/[0.07] px-5 py-4 backdrop-blur"
    >
      <span class="relative flex h-2.5 w-2.5 shrink-0">
        <span class="absolute inline-flex h-full w-full rounded-full bg-mana-400 animate-pulse-ring"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-mana-300"></span>
      </span>
      <p class="text-sm text-neutral-300">
        <span class="eyebrow mr-2 text-[10px] text-mana-300" data-i18n="schedule.upNext">Up next</span>
        <span id="next-event-text" class="font-display font-semibold text-neutral-50"></span>
      </p>
    </div>

    <!-- Tabs -->
    <div data-reveal class="relative mt-8">
      <div data-reveal="right" class="mascot-point-desktop absolute -top-24 right-0 z-10 hidden lg:block">
        <div class="mascot-bubble-wrap">
          <span class="mascot-bubble" data-i18n="bubble.schedule">Pick a night and join us! 🎴</span>
          <img src={MEDIA.mascotPoint.src} alt="Our Mana Games mascot pointing at the schedule" loading="lazy" decoding="async" />
        </div>
      </div>

      <div
        role="tablist"
        aria-label="Tournament schedule by day of the week"
        class="flex gap-2 overflow-x-auto pb-3 pt-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          SCHEDULE.map((day, index) => (
            <button
              type="button"
              role="tab"
              id={`tab-${day.short}`}
              data-day-tab={day.weekday}
              data-index={index}
              aria-controls={`panel-${day.short}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              class="day-tab group relative shrink-0 rounded-xl border border-mana-400/15 bg-black/40 px-4 py-3 text-left transition-all duration-300 hover:border-mana-400/45 sm:px-5"
            >
              <span class="relative z-10 block font-display text-sm font-bold uppercase tracking-wider">
                <span class="sm:hidden" data-i18n-en={day.short} data-i18n-de={DAY_NAMES.de[day.weekday].slice(0, 2).toUpperCase()}>{day.short}</span>
                <span class="hidden sm:inline" data-i18n-en={day.name} data-i18n-de={DAY_NAMES.de[day.weekday]}>{day.name}</span>
              </span>
              <span
                class="relative z-10 mt-1 block text-[10px] font-medium"
                data-i18n-en={day.slots.length > 0 ? `${day.slots.length} tournaments` : 'Closed'}
                data-i18n-de={day.slots.length > 0 ? `${day.slots.length} ${UI.de['schedule.tournaments']}` : UI.de['schedule.closed']}
              >
                {day.slots.length > 0 ? `${day.slots.length} tournaments` : 'Closed'}
              </span>
              <span
                class="today-badge absolute -right-1.5 -top-1.5 z-20 hidden rounded-full bg-mana-400 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-black shadow-[0_0_14px_rgba(46,224,131,.9)]"
                aria-hidden="true"
                data-i18n="schedule.today"
              >
                Today
              </span>
            </button>
          ))
        }
      </div>

      <!-- Panels -->
      <div class="relative mt-4">
        {
          SCHEDULE.map((day, index) => (
            <div
              role="tabpanel"
              id={`panel-${day.short}`}
              aria-labelledby={`tab-${day.short}`}
              data-day-panel={day.weekday}
              hidden={index !== 0}
              class="day-panel panel corners overflow-hidden p-5 sm:p-7"
            >
              {day.slots.length === 0 ? (
                <div class="flex flex-col items-center gap-4 py-14 text-center">
                  <span class="grid h-14 w-14 place-items-center rounded-2xl border border-mana-400/20 text-mana-400/60">
                    <Icon name="tabler:moon-stars" size={24} />
                  </span>
                  <p class="font-display text-xl font-bold text-neutral-200" data-i18n="schedule.sundaysClosed">Sundays we are closed</p>
                  <p class="max-w-sm text-sm text-neutral-500" data-i18n="schedule.sundaysClosedText">
                    We are recharging our mana pools. Back on Monday from 17:00.
                  </p>
                </div>
              ) : (
                <ol class="flex flex-col">
                  {day.slots.map((slot, slotIndex) => (
                    <li
                      data-slot
                      data-weekday={day.weekday}
                      data-time={slot.time}
                      data-label={`${slot.game}${slot.format ? ` (${slot.format})` : ''}`}
                      data-day-name={day.name}
                      style={`--accent:${GAME_COLORS[slot.game] ?? '#2ee083'}; --stagger:${slotIndex * 55}ms;`}
                      class="slot group relative grid grid-cols-[auto_auto_1fr] items-center gap-4 border-b border-white/[0.06] py-4 last:border-b-0 sm:gap-6"
                    >
                      {/* Time */}
                      <span class="w-[4.5rem] shrink-0 font-mono text-base font-semibold tabular-nums text-neutral-300 transition-colors duration-300 group-hover:text-mana-200 sm:text-lg">
                        {slot.time}
                      </span>

                      {/* Timeline dot */}
                      <span class="relative flex h-full w-3 items-center justify-center" aria-hidden="true">
                        <span class="absolute inset-y-0 w-px bg-white/[0.07]" />
                        <span class="slot-dot relative h-2.5 w-2.5 rounded-full" />
                      </span>

                      {/* Game */}
                      <span class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
                        <span class="font-display text-base font-bold text-neutral-100 transition-colors duration-300 sm:text-lg">
                          {slot.game}
                        </span>
                        {slot.format && <span class="slot-format">{slot.format}</span>}
                      </span>

                      <span class="slot-sheen" aria-hidden="true" />
                    </li>
                  ))}
                </ol>
              )}
            </div>
          ))
        }
      </div>
    </div>

    <!-- Footnote -->
    <div
      data-reveal
      class="mt-6 flex flex-col gap-4 rounded-2xl border border-white/[0.07] bg-black/30 px-5 py-4 text-sm text-neutral-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <span class="flex items-center gap-2.5">
        <Icon name="tabler:calendar-check" size={17} class="text-mana-400" />
        <span
          data-i18n-en={`${totalEvents} ${UI.en['schedule.perWeek']}`}
          data-i18n-de={`${totalEvents} ${UI.de['schedule.perWeek']}`}
        >
          {totalEvents} {UI.en['schedule.perWeek']}
        </span>
      </span>
      <span class="flex items-center gap-2.5">
        <Icon name="tabler:door-enter" size={17} class="text-mana-400" />
        <span data-i18n="schedule.regFootnote">Registration on site at the store only</span>
      </span>
    </div>
  </div>
</section>

<style>
  /* Freestanding mascot, no card frame — the art's own alpha fade blends it in */
  .mascot-point-mobile img {
    height: 4.5rem;
    width: auto;
    filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.5));
  }
  .mascot-point-desktop img {
    height: 11rem;
    width: auto;
    filter: drop-shadow(0 14px 22px rgba(0, 0, 0, 0.5));
  }

  .day-tab[aria-selected='true'] {
    border-color: rgba(46, 224, 131, 0.65);
    background: linear-gradient(160deg, rgba(46, 224, 131, 0.18), rgba(5, 8, 6, 0.8));
    box-shadow: 0 0 0 1px rgba(46, 224, 131, 0.25), 0 16px 40px -22px rgba(46, 224, 131, 0.9);
    color: #eafff3;
  }
  .day-tab[aria-selected='false'] {
    color: #a3a3a3;
  }
  .day-tab[aria-selected='false'] span:nth-child(2) {
    color: #6b7280;
  }
  .day-tab[aria-selected='true'] span:nth-child(2) {
    color: rgba(150, 247, 196, 0.9);
  }

  .day-panel[hidden] {
    display: none;
  }

  /* Slots fliegen beim Tab-Wechsel ein */
  .day-panel:not([hidden]) .slot {
    animation: slotIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: var(--stagger);
  }

  @keyframes slotIn {
    from {
      opacity: 0;
      transform: translateX(-14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .slot-dot {
    background: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    transition: box-shadow 0.35s ease, transform 0.35s ease;
  }
  .slot:hover .slot-dot {
    transform: scale(1.25);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 26%, transparent), 0 0 18px var(--accent);
  }

  .slot-format {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    padding: 0.15rem 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    white-space: nowrap;
  }

  .slot-sheen {
    position: absolute;
    inset: 0 -1.25rem;
    border-radius: 0.75rem;
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 13%, transparent), transparent 55%);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
    z-index: -1;
  }
  .slot:hover .slot-sheen {
    opacity: 1;
  }

  /* Currently running / next tournament */
  .slot[data-next='true'] .slot-dot {
    animation: nextPulse 1.8s ease-in-out infinite;
  }
  .slot[data-next='true'] {
    background: linear-gradient(90deg, rgba(46, 224, 131, 0.09), transparent 60%);
  }

  @keyframes nextPulse {
    0%,
    100% {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
    }
    50% {
      box-shadow: 0 0 0 7px color-mix(in srgb, var(--accent) 8%, transparent), 0 0 20px var(--accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .day-panel:not([hidden]) .slot,
    .slot[data-next='true'] .slot-dot {
      animation: none;
    }
  }
</style>

<script>
  import { DAY_NAMES, UI, type Lang } from '../lib/i18n';

  const getLang = (): Lang => ((window as any).mgGetLang?.() as Lang) ?? 'en';

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-day-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-day-panel]'));

  if (tabs.length && panels.length) {
    const select = (weekday: string) => {
      tabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.dayTab === weekday)));
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.dayPanel !== weekday;
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => select(tab.dataset.dayTab!));
    });

    /* Arrow key navigation */
    tabs.forEach((tab, index) => {
      tab.addEventListener('keydown', (event) => {
        const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        event.preventDefault();
        const next = tabs[(index + delta + tabs.length) % tabs.length];
        next.focus();
        select(next.dataset.dayTab!);
      });
    });

    /* Mark today's tab and preselect it */
    const now = new Date();
    const today = String(now.getDay());
    const todayTab = tabs.find((tab) => tab.dataset.dayTab === today);
    if (todayTab) {
      todayTab.querySelector('.today-badge')?.classList.remove('hidden');
      select(today);

      /* Centre the tab horizontally without scrolling the page vertically */
      const list = todayTab.parentElement;
      if (list) {
        list.scrollLeft = todayTab.offsetLeft - (list.clientWidth - todayTab.clientWidth) / 2;
      }
    }

    /* Work out the next tournament */
    const slots = Array.from(document.querySelectorAll<HTMLElement>('[data-slot]'));
    const minutesNow = now.getHours() * 60 + now.getMinutes();
    const dayNow = now.getDay();

    const toMinutes = (time: string) => {
      const [h, m] = time.split(':').map(Number);
      return h * 60 + m;
    };

    /* Minutes from now until the slot, wrapping around the week */
    const distance = (slot: HTMLElement) => {
      const weekday = Number(slot.dataset.weekday);
      let dayDelta = (weekday - dayNow + 7) % 7;
      const minutes = toMinutes(slot.dataset.time!);
      if (dayDelta === 0 && minutes <= minutesNow) dayDelta = 7;
      return dayDelta * 1440 + minutes - minutesNow;
    };

    const upcoming = slots
      .map((slot) => ({ slot, delta: distance(slot) }))
      .sort((a, b) => a.delta - b.delta)[0];

    if (upcoming) {
      upcoming.slot.dataset.next = 'true';

      const banner = document.getElementById('next-event');
      const text = document.getElementById('next-event-text');
      if (banner && text) {
        const renderNextEvent = () => {
          const lang = getLang();
          const { slot, delta } = upcoming;
          const weekday = Number(slot.dataset.weekday);
          /* Same calendar day as today, not just "within 24h" — Tue 20:00
             is ~21.5h from Wed 17:30 but that's tomorrow, not today. */
          const isToday = weekday === dayNow;
          const isTomorrow = weekday === (dayNow + 1) % 7;
          const when =
            delta < 60
              ? `${UI[lang]['schedule.inMin']} ${delta} ${UI[lang]['schedule.min']}`
              : isToday
                ? `${UI[lang]['schedule.todayAt']} ${slot.dataset.time}`
                : isTomorrow
                  ? `${UI[lang]['schedule.tomorrowAt']} ${slot.dataset.time}`
                  : `${DAY_NAMES[lang][weekday]} ${UI[lang]['visit.at']} ${slot.dataset.time}`;
          text.textContent = `${slot.dataset.label} – ${when}`;
        };

        renderNextEvent();
        document.addEventListener('mg:langchange', renderNextEvent);
        banner.classList.remove('hidden');
        banner.classList.add('flex');
      }
    }
  }
</script>
