---
import { Icon } from 'astro-icon/components';
import BrandMark from './brand-mark.astro';
import {
  INSTAGRAM_URL,
  NAV_LINKS,
  SITE,
  TWITCH_URL,
  TWITTER_URL,
  YOUTUBE_URL,
} from '../lib/config';

const socials = [
  { href: INSTAGRAM_URL, icon: 'tabler:brand-instagram', label: 'Instagram', color: '#e1306c' },
  { href: TWITCH_URL, icon: 'tabler:brand-twitch', label: 'Twitch', color: '#9146ff' },
  { href: YOUTUBE_URL, icon: 'tabler:brand-youtube', label: 'YouTube', color: '#ff0033' },
  { href: TWITTER_URL, icon: 'tabler:brand-x', label: 'X', color: '#e5e5e5' },
];

const year = new Date().getFullYear();
const onHome = Astro.url.pathname === '/';
const href = (hash: string) => (onHome ? hash : `/${hash}`);
---

<footer class="relative mt-10 border-t border-mana-400/15 bg-black/50 backdrop-blur-sm">
  <div class="pointer-events-none absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-mana-400/70 to-transparent"></div>

  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-3">
          <BrandMark size={48} class="shrink-0" />
          <span class="font-display text-xl font-bold uppercase tracking-[0.14em] text-neutral-100">
            Mana <span class="text-gradient">Games</span>
          </span>
        </a>

        <p class="mt-5 max-w-xs font-display text-base font-medium text-neutral-300">
          {SITE.tagline}
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-neutral-500">
          Your local game store in Berlin-Wilmersdorf for singles, sealed products,
          accessoires and tournaments.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h2 class="eyebrow text-[10px] font-semibold text-mana-300">Site</h2>
        <ul class="mt-5 flex flex-col gap-3">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={href(link.href)}
                  class="group inline-flex items-center gap-2 text-sm text-neutral-400 transition-colors hover:text-mana-200"
                >
                  <span class="h-px w-0 bg-mana-400 transition-all duration-300 group-hover:w-4" />
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/impressum"
              class="group inline-flex items-center gap-2 text-sm text-neutral-400 transition-colors hover:text-mana-200"
            >
              <span class="h-px w-0 bg-mana-400 transition-all duration-300 group-hover:w-4"></span>
              Legal notice
            </a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h2 id="contact" class="eyebrow scroll-mt-28 text-[10px] font-semibold text-mana-300">Contact</h2>
        <ul class="mt-5 flex flex-col gap-3.5 text-sm">
          <li>
            <a
              href={SITE.mapsUrl}
              target="_blank"
              rel="noopener"
              class="flex items-start gap-2.5 text-neutral-400 transition-colors hover:text-mana-200"
            >
              <Icon name="tabler:map-pin" size={17} class="mt-0.5 shrink-0 text-mana-400" />
              <span>{SITE.street}<br />{SITE.zip}</span>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="flex items-center gap-2.5 text-neutral-400 transition-colors hover:text-mana-200"
            >
              <Icon name="tabler:mail" size={17} class="shrink-0 text-mana-400" />
              {SITE.email}
            </a>
          </li>
          <li class="flex items-start gap-2.5 text-neutral-400">
            <Icon name="tabler:clock" size={17} class="mt-0.5 shrink-0 text-mana-400" />
            <span>Mon – Fri 16:30 – 22:00<br />Sat 13:30 – 22:00<br />Sun closed</span>
          </li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h2 class="eyebrow text-[10px] font-semibold text-mana-300">Follow us</h2>
        <ul class="mt-5 grid grid-cols-4 gap-2 sm:grid-cols-2 lg:grid-cols-4">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={social.label}
                  style={`--accent:${social.color}`}
                  class="social-tile grid aspect-square place-items-center rounded-xl border border-white/[0.08] bg-white/[0.02] text-neutral-400"
                >
                  <Icon name={social.icon} size={19} />
                </a>
              </li>
            ))
          }
        </ul>

        <a
          href="#top"
          class="mt-7 inline-flex items-center gap-2 text-xs text-neutral-500 transition-colors hover:text-mana-200"
        >
          <Icon name="tabler:arrow-up" size={15} />
          Back to top
        </a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-white/[0.06] pt-7 text-xs text-neutral-600 sm:flex-row sm:items-center sm:justify-between"
    >
      <span>© {year} {SITE.name} · Berlin</span>
      <span class="flex items-center gap-2">
        <span class="h-1 w-1 rotate-45 bg-mana-400/70"></span>
        Trading Card Game is not a hobby, but a lifestyle.
      </span>
    </div>
  </div>

  <div class="h-1.5 w-full bg-gradient-to-r from-mana-800 via-mana-400 to-mana-800"></div>
</footer>

<style>
  .social-tile {
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease,
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease;
  }
  .social-tile:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background-color: color-mix(in srgb, var(--accent) 12%, transparent);
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px var(--accent);
  }
</style>
